@model SessionsViewModel
@{ Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>RDP Session Report</title>
    <style>
        body{font-family:Arial,sans-serif;margin:20px;color:#111}h1{font-size:22px}p{font-size:12px}table{border-collapse:collapse;width:100%;font-size:10px;table-layout:fixed}th,td{border:1px solid #bbb;padding:5px;text-align:left;overflow-wrap:anywhere}th{background:#eee}thead{display:table-header-group}tr{break-inside:avoid}button{padding:10px 18px;cursor:pointer}.tools{margin-bottom:20px}
        @@page{size:A3 landscape;margin:10mm}
        @@media print{.tools{display:none}body{margin:0}table{font-size:8pt}}
    </style>
</head>
<body>
    <div class="tools"><button type="button" onclick="window.print()">Print / Save PDF</button> Choose landscape and a suitable paper size in the print dialog.</div>
    <h1>RDP Session Report</h1>
    @if (Model.Error is not null)
    { <p role="alert">@Model.Error</p> }
    else
    {
        <p>@Model.Matched records · Generated @DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss") (server time)</p>
        @if (Model.Search.Length > 0) { <p>Search: @Model.Search</p> }
        <table>
            <thead><tr>@foreach (var header in Model.Headers) { <th scope="col">@header</th> }</tr></thead>
            <tbody>
                @foreach (var row in Model.Rows)
                { <tr>@foreach (var value in row) { <td>@value</td> }</tr> }
            </tbody>
        </table>
    }
</body>
</html>
